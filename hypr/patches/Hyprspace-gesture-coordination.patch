+static bool isHymissionVisible() {
+    if (!g_pPluginSystem)
+        return false;
+
+    HANDLE hymissionHandle = nullptr;
+    for (const auto& p : g_pPluginSystem->getAllPlugins()) {
+        if (p && (p->m_name == "hymission" || p->m_path.find("hymission") != std::string::npos)) {
+            hymissionHandle = p->m_handle;
+            break;
+        }
+    }
+
+    if (!hymissionHandle)
+        return false;
+
+    using PFnIsVisible = bool (*)(const void*);
+    auto fnIsVisible = (PFnIsVisible)dlsym(hymissionHandle, "_ZNK9hymission18OverviewController9isVisibleEv");
+    auto ppController = (void**)dlsym(hymissionHandle, "g_overviewController");
+
+    if (fnIsVisible && ppController && *ppController) {
+        return fnIsVisible(*ppController);
+    }
+
+    return false;
+}
