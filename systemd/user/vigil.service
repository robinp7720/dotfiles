[Unit]
Description=Vigil Wayland desktop cockpit
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=dunst.service

[Service]
Type=simple
ExecStart=%h/.local/bin/vigil
# Keep the desktop service available after an unexpected exit. Vigil itself
# stays alive while startup or output reconfiguration leaves it without windows.
Restart=always
RestartSec=2
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=XDG_CONFIG_HOME=%h/.config

[Install]
WantedBy=graphical-session.target
