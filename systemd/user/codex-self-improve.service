[Unit]
Description=Commit existing dotfiles changes and validate one Codex improvement
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/.dotfiles
ExecStart=%h/.dotfiles/scripts/codex_self_improve.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-%h/.config/codex-self-improve/environment
Nice=10
TimeoutStartSec=2h

