[Unit]
Description=Apply wallpapers and follow output changes
# Match the daemon's target ordering so the target cannot pull the watcher
# before itself and create a cycle that prevents session shutdown.
After=graphical-session.target awww-daemon.service
Requires=awww-daemon.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.dotfiles/scripts/awww_wallpaper_watcher.sh --watch --no-theme
Restart=on-failure
RestartSec=2
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=graphical-session.target
